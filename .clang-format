# C style close to the Barr Group Embedded C Coding Standard:
# 4-space indent, braces on their own line, 100-column limit, pointer next to the name.
# Format a file:  clang-format -i path/to/file.c   (never run it on third_party/)
BasedOnStyle: LLVM
Language: Cpp
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100
BreakBeforeBraces: Custom
BraceWrapping:               # Allman (braces on their own line) ...
  AfterCaseLabel: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterStruct: true
  AfterUnion: true
  BeforeElse: true
  BeforeWhile: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  AfterExternBlock: false    # ... except: extern "C" { stays on one line
IndentExternBlock: NoIndent
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AlwaysBreakAfterReturnType: None
PointerAlignment: Right
AlignConsecutiveMacros: Consecutive
AlignTrailingComments: true
IndentCaseLabels: true
SpaceBeforeParens: ControlStatements
SortIncludes: Never
IncludeBlocks: Preserve
